<section class="proof">
  <div class="wrap">
    <div class="section-head">
      <div class="section-eyebrow">{{ section.settings.eyebrow }}</div>
      <div class="section-title">{{ section.settings.heading }}</div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="product-grid">
        {% for block in section.blocks %}
          <div class="product-card" {{ block.shopify_attributes }}>
            <p class="snippet" style="color:var(--cream);opacity:0.85;">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <div class="biz-name" style="color:var(--gold);margin-top:10px;">{{ block.settings.name }}</div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="proof-placeholder">
        <strong>Testimonial slots ready.</strong><br>
        Add a "Testimonial" block in the theme editor once you have real results to show.
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Results" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Student wins" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "This system paid for itself in the first week." },
        { "type": "text", "id": "name", "label": "Name / handle", "default": "@customer" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
