<section class="stats">
  <div class="wrap stats-grid">
    <div>
      <div class="stat-num">{{ section.settings.stat_1_num }}</div>
      <div class="stat-label">{{ section.settings.stat_1_label }}</div>
    </div>
    <div>
      <div class="stat-num">{{ section.settings.stat_2_num }}</div>
      <div class="stat-label">{{ section.settings.stat_2_label }}</div>
    </div>
    <div>
      <div class="stat-num">{{ section.settings.stat_3_num }}</div>
      <div class="stat-label">{{ section.settings.stat_3_label }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stats bar",
  "settings": [
    { "type": "text", "id": "stat_1_num", "label": "Stat 1 number", "default": "0+" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Students" },
    { "type": "text", "id": "stat_2_num", "label": "Stat 2 number", "default": "0" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Sales made" },
    { "type": "text", "id": "stat_3_num", "label": "Stat 3 number", "default": "0" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Avg. monthly earnings" }
  ],
  "presets": [{ "name": "Stats bar" }]
}
{% endschema %}
